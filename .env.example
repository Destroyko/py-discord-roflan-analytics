# Do not commit .env — copy this file to .env and fill in values.

# --- Required ---
DISCORD_BOT_TOKEN=
GUILD_ID=
STATS_CHANNEL_IDS=123456789012345678,987654321098765432
# Embed + monthly failure alerts; bot needs send-messages in this channel
LEADERBOARD_CHANNEL_ID=

# --- Leaderboard ---
LEADERBOARD_EMOJIS=EBALO
LEADERBOARD_TIMEZONE=Europe/Moscow
LEADERBOARD_TOP_N=10
# TOP per durkichi/roflinkichi channel in LEADERBOARD_CHANNEL_ID (monthly job / post_results)
LEADERBOARD_CHANNEL_TOP_N=5
# Required for LEADERBOARD_CHANNEL_ID posts (channels must be in STATS_CHANNEL_IDS)
# ROLE_DURKICHI_CHANNEL_ID=
# ROLE_ROFLINKICHI_CHANNEL_ID=
DATABASE_PATH=./data/leaderboard.db

# Optional: exclude channels or users from stats / TOP
IGNORE_CHANNEL_IDS=
EXCLUDED_USER_IDS=

# Optional: third-party check to hide a user from a displayed TOP list
# (public monthly TOP 3+2, /show_leaderboard) without touching stored
# message counts. Checked at display time on every run —
# GET {URL}?id=<user_id> with a Bearer token; 200 body true/false decides.
# Excluded users are backfilled from the next rank. Leave USER_CHECK_API_URL
# empty to disable (default).
# USER_CHECK_API_URL=https://example.com/api/anti
# USER_CHECK_API_TOKEN=
# USER_CHECK_API_TIMEOUT_SEC=5

# --- Bot scheduler ---
# Daily incremental sync for the current month (default 04:00 local)
DAILY_SYNC_ENABLED=true
DAILY_SYNC_HOUR=4
DAILY_SYNC_MINUTE=0

# Full recalc + embed on the 1st (default 10:00 local)
LEADERBOARD_MONTHLY_RUN_HOUR=10
LEADERBOARD_MONTHLY_RUN_MINUTE=0

# Roles allowed to run /recalculate_leaderboard (Administrator always can)
MANUAL_RECALC_ROLE_IDS=
